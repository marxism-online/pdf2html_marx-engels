{{ nextpage }}
<a name="{{ anchor }}"> </a>
{% if pm.top_title %}
<p align="CENTER">{{ pm.top_title | safe }}</p>
{% endif %}
{% for h in pm.headings %}
<h{{ h.level }} align="{{ h.align }}">{{ h.text | safe }}</h{{ h.level }}>
{% endfor %}
{% for p in pm.blocks %}
{% if p.is_quote %}
<blockquote>
<p align="JUSTIFY">{{ p | render_inlines }}</p>
</blockquote>
{% elif p.is_small %}
<p align="{{ p.align }}"><small>{{ p | render_inlines }}</small></p>
{% else %}
<p align="{{ p.align }}">{{ p | render_inlines }}</p>
{% endif %}
{% endfor %}
{% if pm.has_bottom_hr %}
<hr style="width:25%; text-align:left; margin-left:0;">
{% endif %}
{% if pm.footnote_block %}
<p align="JUSTIFY"><small>{{ pm.footnote_block | render_inlines }}</small></p>
{% endif %}
{% if pm.signature_block %}
<div style="display:flex; flex-wrap:wrap; gap:0.5em; margin-top:1em;">
<div style="flex:1; min-width:200px;">
{% for p in pm.signature_block.left %}
<p><small>{{ p | render_inlines }}</small></p>
{% endfor %}
</div>
<div style="flex:1; min-width:200px;">
{% for p in pm.signature_block.right %}
<p><small>{{ p | render_inlines }}</small></p>
{% endfor %}
</div>
</div>
{% endif %}